{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noUncheckedIndexedAccess": true,
    "outDir": "dist",
    "paths": {
      "@mcp-server-forge/schemas": ["./packages/schemas/src/index.ts"],
      "@mcp-server-forge/validators": ["./packages/validators/src/index.ts"],
      "@mcp-server-forge/importers": ["./packages/importers/src/index.ts"],
      "@mcp-server-forge/templates": ["./packages/templates/src/index.ts"],
      "@mcp-server-forge/generators": ["./packages/generators/src/index.ts"],
      "@mcp-server-forge/fs-adapter": ["./packages/fs-adapter/src/index.ts"]
    },
    "rootDir": ".",
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node", "vitest/globals"]
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "vitest.config.ts"],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
