{
  "schemaVersion": "1",
  "project": {
    "name": {{json project.name}},
    "title": {{json project.title}},
    "description": {{json project.description}},
    "language": {{json project.language}}
  },
  "server": {
    "name": {{json server.name}},
    "version": {{json server.version}},
    "description": {{json server.description}},
    "runtime": "node",
    "transport": "stdio",
    "entrypoint": "dist/index.js",
    "capabilities": {
      "tools": true,
      "resources": false,
      "prompts": false
    }
  },
  "tools": [
    {
      "name": "hello",
      "title": "Say hello",
      "description": "Return a deterministic local greeting without side effects.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message"],
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 96
          }
        }
      },
      "useWhen": "A user wants to verify that the local MCP server is connected.",
      "avoidWhen": "The request needs files, network access, shell commands, or business data.",
      "riskLevel": "low",
      "readOnly": true,
      "destructive": false,
      "requiresConfirmation": false
    }
  ],
  "distribution": {
    "type": "local-entrypoint",
    "entrypoint": "dist/index.js"
  },
  "environment": [],
  "security": {
    "allowedRootDirectories": [],
    "networkAccess": "none",
    "shellAccess": false,
    "fileWrite": false,
    "fileDelete": false,
    "requireConfirmation": false,
    "maxResponseBytes": 1024,
    "timeoutMs": 30000
  }
}
